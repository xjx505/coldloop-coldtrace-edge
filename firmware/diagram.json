{
  "version": 1,
  "author": "ColdLoop",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-c3-devkitm-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -40,
      "left": 230,
      "attrs": { "temperature": "4.5", "humidity": "82" }
    },
    {
      "type": "wokwi-gas-sensor",
      "id": "gas",
      "top": 120,
      "left": 230,
      "attrs": { "ppm": "400", "threshold": "4.4" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht:VCC", "esp:3V3.1", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:4", "green", [] ],
    [ "gas:VCC", "esp:5V.1", "red", [] ],
    [ "gas:GND", "esp:GND.2", "black", [] ],
    [ "gas:AO", "esp:0", "orange", [] ]
  ],
  "serialMonitor": { "display": "terminal" },
  "dependencies": {}
}
